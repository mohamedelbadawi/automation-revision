{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@fixtures/*": ["./src/fixtures/*"]
    },
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "tests/**/*", "e2e/**/*", "playwright.config.ts"]
}
